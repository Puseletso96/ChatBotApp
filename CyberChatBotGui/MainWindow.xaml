<Window x:Class="CyberChatBotGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberChatbot - Cybersecurity Awareness Bot" 
        Height="750" Width="1050"
        Background="#1A1025"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- Row 0: Header -->
            <RowDefinition Height="130"/>
            <!-- Row 1: Main Content (Tabs) -->
            <RowDefinition Height="*"/>
            <!-- Row 2: Input Area -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER / ASCII ART ==================== -->
        <Border Grid.Row="0"
                Background="#2D1B4E"
                CornerRadius="10"
                Padding="5"
                Margin="0,0,0,10">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="AsciiArtTextBlock"
                           FontFamily="Consolas"
                           FontSize="4"
                           Foreground="#FF2E93"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="NoWrap"/>

                <TextBlock Text="CYBERSECURITY AWARENESS BOT" 
                           FontSize="14" 
                           FontWeight="Bold" 
                           Foreground="#FF2E93"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
                <TextBlock Text="Stay Safe. Stay Secure. Stay Smart." 
                           FontSize="10" 
                           Foreground="#B8A9D4"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- ==================== MAIN CONTENT (TABS) ==================== -->
        <Border Grid.Row="1" Background="#2D1B4E" CornerRadius="10" Padding="10" Margin="0,0,0,10">
            <TabControl x:Name="MainTabControl" Background="Transparent" BorderThickness="0">

                <!-- Tab 1: The Chat -->
                <TabItem Header="Chatbot" Foreground="Black">
                    <Grid Background="#1A1025">
                        <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ChatStackPanel" Margin="10"/>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- Tab 2: Tasks -->
                <TabItem Header="Tasks" Foreground="Black">
                    <Grid Background="#1A1025" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT PANEL: ADD TASK -->
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Add a Security Task" Foreground="#00E5FF" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                            <TextBlock Text="Title:" Foreground="White" Margin="0,0,0,5"/>
                            <TextBox x:Name="TaskTitleInput" Background="#3D275E" Foreground="White" Padding="5" BorderThickness="0" Margin="0,0,0,15"/>

                            <TextBlock Text="Description:" Foreground="White" Margin="0,0,0,5"/>
                            <TextBox x:Name="TaskDescInput" Background="#3D275E" Foreground="White" Padding="5" BorderThickness="0" Height="60" TextWrapping="Wrap" Margin="0,0,0,15"/>

                            <TextBlock Text="Reminder Date:" Foreground="White" Margin="0,0,0,5"/>
                            <DatePicker x:Name="TaskDateInput" Background="#3D275E" BorderThickness="0" Margin="0,0,0,20" Padding="5"/>

                            <Button Content="Add Task" Click="AddTaskForm_Click" Background="#00E5FF" Foreground="Black" FontWeight="Bold" Padding="10" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>

                        <!-- RIGHT PANEL: DATA GRID -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Refresh Tasks" Click="RefreshTasks_Click" Padding="5,2" Background="#3D275E" Foreground="White" BorderThickness="0"/>
                            </StackPanel>

                            <DataGrid x:Name="TaskDataGrid" Grid.Row="1" AutoGenerateColumns="False" 
                                      Background="#1A1025" RowBackground="#2D1B4E" AlternatingRowBackground="#3D275E"
                                      Foreground="White" BorderThickness="0" 
                                      CanUserAddRows="False" IsReadOnly="True">

                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#3D275E"/>
                                        <Setter Property="Foreground" Value="#00E5FF"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGrid.Resources>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                                    <DataGridTextColumn Header="Reminder" Binding="{Binding ReminderDate, StringFormat='yyyy-MM-dd HH:mm'}" Width="150" />

                                    <DataGridTemplateColumn Header="Actions" Width="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Complete" Background="LightGreen" Foreground="Black" 
                                                            Margin="0,0,5,0" Padding="5,2" BorderThickness="0" FontWeight="Bold"
                                                            Click="CompleteTask_Click" Tag="{Binding TaskID}"/>

                                                    <Button Content="Delete" Background="#FF4C4C" Foreground="White" 
                                                            Padding="5,2" BorderThickness="0" FontWeight="Bold"
                                                            Click="DeleteTask_Click" Tag="{Binding TaskID}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Tab 3: The Quiz (NEW TAB) -->
                <TabItem Header="Quiz" Foreground="Black">
                    <Grid Background="#1A1025" Margin="10">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="600">

                            <TextBlock Text="Cybersecurity Mini-Game" Foreground="#FF2E93" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                            <TextBlock x:Name="QuizQuestionText" Foreground="White" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,20" TextAlignment="Center" Text="Click 'Start Quiz' to test your knowledge!"/>

                            <Button x:Name="QuizBtnA" Content="Option A" Margin="0,5" Padding="10" Background="#3D275E" Foreground="White" BorderThickness="0" Click="QuizAnswer_Click" Tag="0" Visibility="Collapsed"/>
                            <Button x:Name="QuizBtnB" Content="Option B" Margin="0,5" Padding="10" Background="#3D275E" Foreground="White" BorderThickness="0" Click="QuizAnswer_Click" Tag="1" Visibility="Collapsed"/>
                            <Button x:Name="QuizBtnC" Content="Option C" Margin="0,5" Padding="10" Background="#3D275E" Foreground="White" BorderThickness="0" Click="QuizAnswer_Click" Tag="2" Visibility="Collapsed"/>
                            <Button x:Name="QuizBtnD" Content="Option D" Margin="0,5" Padding="10" Background="#3D275E" Foreground="White" BorderThickness="0" Click="QuizAnswer_Click" Tag="3" Visibility="Collapsed"/>

                            <TextBlock x:Name="QuizFeedbackText" Foreground="#A6E3A1" FontSize="16" FontWeight="Bold" Margin="0,20,0,0" TextAlignment="Center"/>
                            <TextBlock x:Name="QuizScoreText" Foreground="#FF2E93" FontSize="18" Margin="0,10,0,0" TextAlignment="Center"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                <Button x:Name="QuizStartBtn" Content="Start Quiz" Padding="15,5" Background="#00E5FF" Foreground="Black" FontWeight="Bold" BorderThickness="0" Click="QuizStartBtn_Click" Margin="0,0,10,0"/>
                                <Button x:Name="QuizResetBtn" Content="Reset Quiz" Padding="15,5" Background="#FF2E93" Foreground="White" BorderThickness="0" Click="QuizResetBtn_Click" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- ==================== INPUT AREA ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    Background="#3D275E" 
                    CornerRadius="10" 
                    Padding="5"
                    Margin="0,0,10,0">
                <TextBox x:Name="UserInputTextBox" 
                         FontSize="16" 
                         Background="Transparent"
                         Foreground="White"
                         BorderThickness="0"
                         Padding="10"
                         VerticalContentAlignment="Center"
                         KeyDown="UserInputTextBox_KeyDown"/>
            </Border>

            <Button Grid.Column="1" 
                    x:Name="SendButton" 
                    Content="SEND" 
                    Width="120" 
                    Height="45"
                    Background="#FF2E93"
                    Foreground="#1A1025"
                    FontSize="16" 
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>