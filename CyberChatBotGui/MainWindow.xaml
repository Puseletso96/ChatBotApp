<Window x:Class="CyberChatBotGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberChatbot - Cybersecurity Awareness Bot" 
        Height="750" Width="1050"
        Background="#1A1025"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- Row 0: Header. Fixed height so it NEVER pushes the input box off the screen -->
            <RowDefinition Height="130"/>
            <!-- Row 1: Chat Area. Takes all remaining space. -->
            <RowDefinition Height="*"/>
            <!-- Row 2: Input Area. Stays at the bottom. -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER / ASCII ART ==================== -->
        <Border Grid.Row="0"
                Background="#2D1B4E"
                CornerRadius="10"
                Padding="5"
                Margin="0,0,0,10">
            <StackPanel VerticalAlignment="Center">

                <!-- ASCII Art TextBlock (Required by rubric, FontSize 6 to fit) -->
                <TextBlock x:Name="AsciiArtTextBlock"
                           FontFamily="Consolas"
                           FontSize="6"
                           Foreground="#FF2E93"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="NoWrap"/>

                <TextBlock Text="CYBERSECURITY AWARENESS BOT" 
                           FontSize="14" 
                           FontWeight="Bold" 
                           Foreground="#FF2E93"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
                <TextBlock Text="Stay Safe. Stay Secure. Stay Smart." 
                           FontSize="10" 
                           Foreground="#B8A9D4"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- ==================== CHAT AREA ==================== -->
        <Border Grid.Row="1"
                Background="#2D1B4E"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,10">

            <!-- We use a ScrollViewer to allow scrolling, and a StackPanel to hold the chat bubbles -->
            <ScrollViewer x:Name="ChatScrollViewer" 
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ChatStackPanel"/>
            </ScrollViewer>
        </Border>
        <!-- ==================== INPUT AREA ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    Background="#3D275E" 
                    CornerRadius="10" 
                    Padding="5"
                    Margin="0,0,10,0">
                <TextBox x:Name="UserInputTextBox" 
                         FontSize="16" 
                         Background="Transparent"
                         Foreground="White"
                         BorderThickness="0"
                         Padding="10"
                         VerticalContentAlignment="Center"
                         KeyDown="UserInputTextBox_KeyDown"/>
            </Border>

            <Button Grid.Column="1" 
                    x:Name="SendButton" 
                    Content="SEND" 
                    Width="120" 
                    Height="45"
                    Background="#FF2E93"
                    Foreground="#1A1025"
                    FontSize="16" 
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>