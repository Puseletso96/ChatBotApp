<Window x:Class="CyberChatBotGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberChatbot - Cybersecurity Awareness Bot" 
        Height="750" Width="1050"
        Background="#1A1025"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- Row 0: Header -->
            <RowDefinition Height="130"/>
            <!-- Row 1: Main Content (Tabs) -->
            <RowDefinition Height="*"/>
            <!-- Row 2: Input Area -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER / ASCII ART ==================== -->
        <Border Grid.Row="0"
                Background="#2D1B4E"
                CornerRadius="10"
                Padding="5"
                Margin="0,0,0,10">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="AsciiArtTextBlock"
                           FontFamily="Consolas"
                           FontSize="4"
                           Foreground="#FF2E93"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="NoWrap"/>

                <TextBlock Text="CYBERSECURITY AWARENESS BOT" 
                           FontSize="14" 
                           FontWeight="Bold" 
                           Foreground="#FF2E93"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
                <TextBlock Text="Stay Safe. Stay Secure. Stay Smart." 
                           FontSize="10" 
                           Foreground="#B8A9D4"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- ==================== MAIN CONTENT (TABS) ==================== -->
        <Border Grid.Row="1" Background="#2D1B4E" CornerRadius="10" Padding="10" Margin="0,0,0,10">
            <TabControl Background="Transparent" BorderThickness="0">

                <!-- Tab 1: The Chat -->
                <TabItem Header="Chatbot" Foreground="Black">
                    <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" Background="#1A1025">
                        <StackPanel x:Name="ChatStackPanel" Margin="10"/>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 2: Tasks -->
                <TabItem Header="Tasks" Foreground="Black">
                    <Grid Background="#1A1025" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Refresh Tasks" Click="RefreshTasks_Click" Margin="0,0,10,0" Padding="5" Background="#FF2E93" Foreground="White" BorderThickness="0"/>
                        </StackPanel>

                        <ListBox Grid.Row="1" x:Name="TaskListBox" Background="#2D1B4E" Foreground="White" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="5">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="#FF2E93"/>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#B8A9D4"/>
                                        <TextBlock Text="{Binding ReminderDate, StringFormat='Reminder: {0:yyyy-MM-dd}'}" Foreground="White"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- ==================== INPUT AREA ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    Background="#3D275E" 
                    CornerRadius="10" 
                    Padding="5"
                    Margin="0,0,10,0">
                <TextBox x:Name="UserInputTextBox" 
                         FontSize="16" 
                         Background="Transparent"
                         Foreground="White"
                         BorderThickness="0"
                         Padding="10"
                         VerticalContentAlignment="Center"
                         KeyDown="UserInputTextBox_KeyDown"/>
            </Border>

            <Button Grid.Column="1" 
                    x:Name="SendButton" 
                    Content="SEND" 
                    Width="120" 
                    Height="45"
                    Background="#FF2E93"
                    Foreground="#1A1025"
                    FontSize="16" 
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>